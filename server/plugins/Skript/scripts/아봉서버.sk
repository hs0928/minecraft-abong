command 바닥지우기참가:
    trigger:
        if {바닥지우기게임참가자::*} does not contain player:
            send "%nl%&e바닥지우기 게임에 참가하였습니다%nl%" to player
            play sound "minecraft:entity.experience_orb.pickup" with volume 1 to player
            add player to {바닥지우기게임참가자::*}
        else:
            send "%nl%&c이미 바닥지우기 게임에 참가자로 참여했습니다%nl%" to player

command 바닥지우기참가취소:
    trigger:
        if {바닥지우기게임참가자::*} contain player:
            send "%nl%&e바닥지우기 게임 참가를 취소하였습니다%nl%" to player
            play sound "minecraft:entity.experience_orb.pickup" with volume 1 to player
            remove player from {바닥지우기게임참가자::*}
        else:
            send "%nl%&c당신은 이미 바닥지우기 게임 참가자가 아닙니다%nl%" to player

command z미니게임팀확인:
    trigger:
        if player is op:
            send "레드팀 : %{미니겜레드팀::*}%%nl%블루팀 : %{미니겜블루팀::*}%" to player

command z미니게임팀추가 [<text>] [<text>]:
    trigger:
        if player is op:
            if arg-1 is set:
                loop all players:
                    if name of loop-player is arg-1:
                        if arg-2 is set:
                            if arg-2 is "레드":
                                if {미니겜레드팀::*} does not contain loop-player:
                                    if {미니겜블루팀::*} does not contain loop-player:
                                        add loop-player to {미니겜레드팀::*}
                                        send "&e%loop-player%님을 레드팀에 추가하였습니다" to player
                                    else:
                                        send "&c해당 플레이어는 이미 팀에 속해있습니다%nl%해당 플레이어의 팀을 제거하시려면 /z미니게임팀제거 [플레이어번호] 명령어를 사용해주세요" to player
                                else:
                                    send "&c해당 플레이어는 이미 팀에 속해있습니다%nl%해당 플레이어의 팀을 제거하시려면 /z미니게임팀제거 [플레이어번호] 명령어를 사용해주세요" to player
                            if arg-2 is "블루":
                                if {미니겜블루팀::*} does not contain loop-player:
                                    if {미니겜레드팀::*} does not contain loop-player:
                                        add loop-player to {미니겜블루팀::*}
                                        send "&e%loop-player%님을 블루팀에 추가하였습니다" to player
                                    else:
                                        send "&c해당 플레이어는 이미 팀에 속해있습니다%nl%해당 플레이어의 팀을 제거하시려면 /z미니게임팀제거 [플레이어번호] 명령어를 사용해주세요" to player
                                else:
                                    send "&c해당 플레이어는 이미 팀에 속해있습니다%nl%해당 플레이어의 팀을 제거하시려면 /z미니게임팀제거 [플레이어번호] 명령어를 사용해주세요" to player
                            else if arg-2 is not "레드" or "블루":
                                send "&c플레이어의 팀을 레드 / 블루 둘중 하나로 입력해주세요" to player
                        else:
                            send "&c플레이어의 팀을 입력해주세요" to player
            else:
                send "&c플레이어를 설정해주세요" to player

command z미니게임팀제거 [<player>]:
    trigger:
        if player is op:
            if arg-1 is set:
                loop all players:
                    if name of loop-player is arg-1:
                        remove loop-player from {미니겜레드팀::*}
                        remove loop-player from {미니겜블루팀::*}
                        send "&e%loop-player%님의 팀을 제거하였습니다" to player
            else:
                send "&c팀을 제거할 플레이어번호를 입력해주세요" to player


command 후원연동 [<player>] [<text>]:
    trigger:
        if player is op:
            send "&e%arg-player%(현재기준)님의 숲 아이디를 %arg-text%로 설정하였습니다." to player
            set {숲아이디::%uuid of arg-player%} to arg-text
            player command "api관리 연동 %arg-player% 숲 %{숲아이디::%uuid of arg-player%}%"
            wait 10 tick
            player command "api관리 시작 %arg-player%"


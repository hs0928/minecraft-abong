every 1 seconds:
    if {움직이기금지} > 0:
        remove 1 from {움직이기금지}
    else if {움직이기금지} = 0:
        delete {움직이기금지}
        send "%nl%&e움직이기 금지가 해제되었습니다%nl%" to all players
        play sound "entity.player.levelup" with volume 1 with pitch 2 to all players
    loop all players:
        {c.e::%loop-player's uuid%} > 0:
            remove 1 from {c.e::%loop-player's uuid%}
        else:
            set {c.e::%loop-player's uuid%} to 0
    set {_realtime} to now formatted human-readable as "HH:mm.ss"
    #send "%{_realtime}%" to all players
    if {_realtime} is "18:00.00":
        loop size of {접속목록::*} times:
            add 1 to {_랜덤}
            console command "닉네임관리 설정 %{_랜덤}% r%{_랜덤}%"
        delete {접속목록1::*}
        loop {접속목록::*}:
            add loop-value to {접속목록1::*}
        delete {countrandom}
        set {_cimsi} to size of {접속목록1::*}
        loop {_cimsi} times:
            set {_임시} to random element of {접속목록1::*}
            remove {_임시} from {접속목록1::*}
            add 1 to {countrandom}
            set {번호::%uuid of {_임시}%} to {countrandom}
            wait 2 tick
            console command "닉네임관리 설정 %{_임시}% %{번호::%uuid of {_임시}%}%"
            console command "api관리 연동 %{_임시}% 숲 %{숲아이디::%uuid of {_임시}%}%"
        send "%nl%&e닉네임이 랜덤으로 변경되었습니다%nl%" to all players
        play sound "entity.player.levelup" to all players
        loop {s.l::*}:
            set {_r} to random integer between 1 and 10
            set {s.l::%loop-index%} to {_r}
        send "%nl%&a표지판 제한 횟수가 랜덤으로 설정되었습니다%nl%" to all players
        play sound "entity.experience_orb.pickup" with volume 0.5 with pitch 1 to all players
        loop {우편발송대기::*}:
            loop {우편보낸횟수::%uuid of loop-value%} times:
                add 1 to {보낸횟수카운트::%uuid of loop-value-1%}
                add {우편보낼아이템%{보낸횟수카운트::%uuid of loop-value-1%}%::%uuid of loop-value-1%} to {post.%{우편받을사람%{보낸횟수카운트::%uuid of loop-value-1%}%::%uuid of loop-value-1%}%::*}
                delete {우편보낼아이템%{보낸횟수카운트::%uuid of loop-value-1%}%::%uuid of loop-value-1%}
                delete {우편받을사람%{보낸횟수카운트::%uuid of loop-value-1%}%::%uuid of loop-value-1%}
        send "%nl%&e우편이 도착하였습니다%nl%" to {우편받는사람목록::*}
        play sound "minecraft:entity.experience_orb.pickup" with volume 1 to {우편받는사람목록::*}
        loop {우편발송대기::*}:
            delete {우편보낸사람.%uuid of loop-value%::*}
        delete {우편받는사람목록::*}
        delete {우편보낸횟수::*}
        delete {우편발송대기::*}
        delete {보낸횟수카운트::*}
        wait 600 seconds
        give 1 writable book named "&f편지" to all players
        send "%nl%&e편지가 지급되었습니다.%nl%" to all players
        play sound "minecraft:entity.experience_orb.pickup" to all players
    if {_realtime} is "00:00.00":
        delete {출첵::*}

command 별풍선 [<player>] [<integer>]:
    trigger:
        if arg-integer is 10000:
            set {_r} to random integer between 1 and 10
            play sound "entity.experience_orb.pickup" with volume 0.5 with pitch 1 to arg-player
            send "%nl%&6* &b별풍선 &e100&f개를 후원받아 &7%{_r}%초 &f동안 채팅이 활성화되었습니다 &6*%nl%" to arg-player
            add {_r}+1 to {c.e::%arg-player's uuid%}
        if arg-integer is 50000:
            play sound "block.anvil.land" with volume 0.5 with pitch 0.5 to arg-player
            set {_r} to random integer between 1 and 1000
            {_r} is between 1 and 250:
                spawn 3 zombie at arg-player
                send "%nl%&6* &b별풍선 &9500&f개를 후원받아 &3좀비 3마리&f가 생성되었습니다 &6*%nl%" to arg-player
                stop
            {_r} is between 251 and 450:
                spawn 3 skeleton at arg-player
                send "%nl%&6* &b별풍선 &9500&f개를 후원받아 &7스켈레톤 3마리&f가 생성되었습니다 &6*%nl%" to arg-player
                stop
            {_r} is between 451 and 650:
                spawn 3 spider at arg-player
                send "%nl%&6* &b별풍선 &9500&f개를 후원받아 &8거미 3마리&f가 생성되었습니다 &6*%nl%" to arg-player
                stop
            {_r} is between 651 and 850:
                spawn 2 creeper at arg-player
                send "%nl%&6* &b별풍선 &9500&f개를 후원받아 &a크리퍼 2마리&f가 생성되었습니다 &6*%nl%" to arg-player
                stop
            {_r} is between 851 and 950:
                spawn 1 witch at arg-player
                send "%nl%&6* &b별풍선 &9500&f개를 후원받아 &d마녀 1마리&f가 생성되었습니다 &6*%nl%" to arg-player
                stop
            {_r} is between 951 and 1000:
                spawn 1 vindicator at arg-player
                send "%nl%&6* &b별풍선 &9500&f개를 후원받아 &7변명자 1마리&f가 생성되었습니다 &6*%nl%" to arg-player
                stop
        if arg-integer is 299900:
            send "%nl%&6* &e%arg-player%번님이 &b별풍선 &a2999&f개를 후원받아 &e모든 플레이어&f의 채팅이 &71분 &f동안 활성화 되었습니다 &6*%nl%" to all players
            play sound "entity.player.levelup" to all players
            loop all players:
                add 60 to {c.e::%uuid of loop-player%}
        if arg-integer is 499900:
            send "%nl%&6* &e%arg-player%번님이 &b별풍선 &b4999&f개를 정신과 시간의 방에 수감 될 한명을 지목합니다 &6*%nl%" to all players
            play sound "ui.toast.challenge_complete" with volume 1 with pitch 1.5 to all players
        if arg-integer is 777700:
            set {움직이기금지} to 30
            send "%nl%&6* &e%arg-player%번님이 &b별풍선 &c7&a7&b7&e7&f개를 후원받아 30초간 전체 이동이 금지됩니다 &6*%nl%" to all players
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 0.9 to all players
            wait 4 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 1.2 to all players
            wait 4 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 1.2 to all players
            wait 7 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 1.2 to all players
            wait 7 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 1.05 to all players
            wait 7 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 1.2 to all players
            wait 4 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 1.2 to all players
            wait 4 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 0.9 to all players
            wait 3 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 0.9 to all players
            wait 3 tick
            play sound "minecraft:block.note_block.bit" with volume 1 with pitch 1.05 to all players
        if arg-integer is 1000000:
            set {_p} to arg-player's location
            kill the arg-player
            send "%nl%&6* &e%arg-player%번님이 &b별풍선 &c1&60&f,&e0&20&90&f개를 후원받아 즉사하셨습니다 &6*%nl%" to all players
            play sound "ui.toast.challenge_complete" with volume 1 with pitch 1 to all players
            create safe explosion of force 5 at {_p}
            strike lightning effect at {_p}
            loop 5 times:
                launch flickering ball large coloured red, green and yellow fading to light green and black at {_p} with duration 4
                wait 1 tick

command z폭죽:
    trigger:
        if player is op:
            launch flickering ball large coloured red, green and yellow fading to light green and black at {폭죽::*} with duration 4

command z폭죽아이템:
    trigger:
        if player is op:
            give stick named "&9폭죽위치지정(우클릭)" to player

command z폭죽위치초기화:
    trigger:
        if player is op:
            delete {폭죽::*}

on rightclick:
    if player's tool's name is "&9폭죽위치지정(우클릭)":
        add player's location to {폭죽::*}
        send "현재 위치가 폭죽이 터지는 구역으로 지정되었습니다" to player

on first join:
    teleport player to location at 2845, 67, 267

on player walk:
    if {움직이기금지} is set:
        cancel event

command /z표지판제한 [<player>] [<integer>]:
    trigger:
        player is op
        arg-player is set
        arg-integer is set
        set {s.l::%arg-player's uuid%} to arg-integer
        send "%arg-player%님의 표지판 제한 횟수를 %arg-integer%으(로) 설정했습니다" to player
on load:
    delete {c.e::*}
on join:
    {s.l::%player's uuid%} isn't set:
        set {s.l::%player's uuid%} to 5
on sign change:
    {s.l::%player's uuid%} isn't 0:
        remove 1 from {s.l::%player's uuid%}
        send "&c표지판 사용 횟수가 %{s.l::%player's uuid%}%번 남았습니다" to player
    else:
        cancel event
        send "&c표지판을 사용하실 수 없습니다" to player
on chat:
    if {관리자::*} does not contain player:
        {c.e::%player's uuid%} = 0:
            cancel event
            send "&c채팅을 치실 수 없습니다" to player
            #if {편지쓰는중::%uuid of player%} is not true:
                #send "&c채팅을 치실 수 없습니다" to player

command z접속초기화:
    trigger:
        if player is op:
            delete {이름카운트a}
            delete {번호::*}
            delete {접속목록::*}
            delete {관리자제외전체인원::*}

command z접속확인:
    trigger:
        if player is op:
            send "이름카운트 %{이름카운트a}%%nl%번호 %{번호::*}%%nl%접속목록 %{접속목록::*}%%nl%관리자제외전체인원 %{관리자제외전체인원::*}%" to player
            loop all players:
                if {출첵::%uuid of loop-player%} is true:
                    send "출첵목록 : %loop-value%" to player

on quit:
    if {관리자::*} does not contain player:
        add 1 to {나간번째}
        console command "닉네임관리 설정 %player% quit%{나간번째}%"

on join:
    if {관리자::*} does not contain player:
        set skin of player to skin of "_glape"
        if {번호::%uuid of player%} is not set:
            add 1 to {이름카운트a}
            set {번호::%uuid of player%} to {이름카운트a}
        wait 10 tick
        console command "닉네임관리 설정 %player% %{번호::%uuid of player%}%"
        console command "api관리 연동 %player% 숲 %{숲아이디::%uuid of player%}%"

command z닉네임랜덤:
    trigger:
        if player is op:
            loop size of {접속목록::*} times:
                add 1 to {_랜덤}
                console command "닉네임관리 설정 %{_랜덤}% r%{_랜덤}%"
            delete {접속목록1::*}
            loop {접속목록::*}:
                add loop-value to {접속목록1::*}
            delete {countrandom}
            set {_cimsi} to size of {접속목록1::*}
            loop {_cimsi} times:
                set {_임시} to random element of {접속목록1::*}
                remove {_임시} from {접속목록1::*}
                add 1 to {countrandom}
                set {번호::%uuid of {_임시}%} to {countrandom}
                wait 2 tick
                console command "닉네임관리 설정 %{_임시}% %{번호::%uuid of {_임시}%}%"
                console command "api관리 연동 %{_임시}% 숲 %{숲아이디::%uuid of {_임시}%}%"
            send "%nl%&e닉네임이 랜덤으로 변경되었습니다%nl%" to all players
            play sound "entity.player.levelup" to all players

command z관리자:
    trigger:
        if player is op:
            if {관리자::*} does not contain player:
                add player to {관리자::*}
                send "관리자에 추가됨" to player
                remove player from {관리자제외전체인원::*}
                delete {번호::%uuid of player%}
                remove player from {접속목록::*}

command z관리자나가기:
    trigger:
        if player is op:
            remove player from {관리자::*}
            send "관리자에서 제거됨"

command z관리자확인:
    trigger:
        if player is op:
            send "%{관리자::*}%" to player

on join:
    if {관리자제외전체인원::*} does not contain player:
        if {관리자::*} does not contain player:
            add player to {관리자제외전체인원::*}
    if {접속목록::*} does not contain player:
        if {관리자::*} does not contain player:
            add player to {접속목록::*}

on quit:
    remove player from {관리자제외전체인원::*}

on join:
    set join message to ""

on quit:
    set quit message to ""

command z편지 [<player>]:
    trigger:
        if player is op:
            if arg is not set:
                #give 1 paper named "&f편지" with lore "&e&o편지를 들고 우클릭하여 편지쓰기" to all players
                give 1 writable book named "&f편지" to all players
                send "%nl%&e편지가 지급되었습니다.%nl%" to all players
                play sound "minecraft:entity.experience_orb.pickup" to all players
            else:
                #give 1 paper named "&f편지" with lore "&e&o편지를 들고 우클릭하여 편지쓰기" to arg-player
                give 1 writable book named "&f편지" to arg-player
                send "%nl%&e편지가 지급되었습니다.%nl%" to arg-player
                play sound "minecraft:entity.experience_orb.pickup" to arg-player

on craft of writable book:
    cancel event
    send "&c해당 아이템은 조합할 수 없습니다" to player


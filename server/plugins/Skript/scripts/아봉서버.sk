command z초대권구매비용초기화:
    trigger:
        set {초대권구매비용} to 50

on rightclick on entity:
    if name of entity contain "편지상점":
        open chest with 3 rows named "&f편지 상점" to player
        play sound "minecraft:entity.experience_orb.pickup" to player
        set slot 13 of current inventory of player to writable book named "&f편지" with lore "&7클릭하여 획득"

on rightclick on entity:
    if name of entity contain "자재상점":
        open chest with 3 rows named "&8건축자재 상점" to player
        play sound "minecraft:entity.experience_orb.pickup" to player
        set slot 0 of current inventory of player to 5 of quartz block named "&f석영 블럭 (5개)" with lore "&e비용 : &6금 &e1개"
        set slot 2 of current inventory of player to white terracotta named "&f테라코타류"
        set slot 4 of current inventory of player to white concrete named "&f콘크리트류"
        set slot 6 of current inventory of player to sea lantern named "&b바다 랜턴" with lore "&e비용 : &6금 &e6개%nl%&7좌클릭으로 한개씩 구매%nl%&7쉬프트+좌클릭으로 10개씩 구매%nl%&7쉬프트+우클릭으로 1세트씩 구매"
        set slot 8 of current inventory of player to raw prismarine block named "&9프리즈머린류"
        set slot 18 of current inventory of player to nether brick block named "&c네더 벽돌" with lore "&e비용 : &6금 &e4개%nl%&7좌클릭으로 한개씩 구매%nl%&7쉬프트+좌클릭으로 10개씩 구매%nl%&7쉬프트+우클릭으로 1세트씩 구매"
        set slot 20 of current inventory of player to deepslate block named "&8심층암" with lore "&e비용 : &7조약돌 &e2개%nl%&7좌클릭으로 한개씩 구매%nl%&7쉬프트+좌클릭으로 10개씩 구매%nl%&7쉬프트+우클릭으로 1세트씩 구매"
        set slot 22 of current inventory of player to smooth stone named "&7매끄러운 돌" with lore "&e비용 : &7조약돌 &e2개%nl%&7좌클릭으로 한개씩 구매%nl%&7쉬프트+좌클릭으로 10개씩 구매%nl%&7쉬프트+우클릭으로 1세트씩 구매"
        set slot 24 of current inventory of player to living tube coral block named "&9산호블럭류"
        set slot 26 of current inventory of player to candles named "&f양초류"

on rightclick on entity:
    if name of entity contain "초대권상점":
        open chest with 3 rows named "&9초대권 상점" to player
        play sound "minecraft:entity.experience_orb.pickup" to player
        set slot 13 of current inventory of player to itemsadder item "ab:invite" named "&e초대권" with lore "&e구매비용 : &b다이아몬드 &e%{초대권구매비용}%개"

on rightclick on entity:
    if name of entity contain "결혼권상점":
        open chest with 3 rows named "강제결혼권 상점" to player
        play sound "minecraft:entity.experience_orb.pickup" to player
        set slot 13 of current inventory of player to itemsadder item "ab:gangjae" named "&c강제결혼권" with lore "&e구매비용 : &b다이아몬드 &e64개"

on inventory click:
    if event-item is itemsadder item "icon_left_blue" named "&f뒤로가기":
        cancel event
        open chest with 3 rows named "&8건축자재 상점" to player

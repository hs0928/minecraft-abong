command /msg [<player>] [<text>]:
	aliases: /message, /귓속말
	trigger:
		if arg-1 is not set:
			send " 사용법 : &b/msg <플레이어> <메세지>" to player
			stop
		if arg-2 is not set:
			send "사용법 : &b/msg <플레이어> <메세지>" to player
			stop
		if arg-1 is set:
			if arg-2 is set:
				send "&bFrom: &a%player%&r &7> &6%arg 2%" to arg 1
				send "&bTo: &a%arg 1%&r &7> &6%arg 2%" to player
				play sound "entity.experience_orb.pickup" to player

on damage:
    if x-coord of victim is 2835.5:
        if y-coord of victim is between 79 and 80:
            if z-coord of victim is 347.5:
                cancel event

on rightclick on barrier:
    if x-coord of event-block is 2835.5:
        if y-coord of event-block is 79.5 or 80.5:
            if z-coord of event-block is 347.5:
                open chest with 6 rows named "&e우편함" to player
                wait 1 tick
                set {_postinv} to 0
                loop {post.%uuid of player%::*}:
                    set slot {_postinv} of current inventory of player to loop-value
                    add 1 to {_postinv}

command z스킨 [<player>]:
    trigger:
        set skin of arg-1 to skin of "_glape"

on place:
    if x-coord of event-block is between 2882 and 2886:
        if y-coord of event-block is between 78 and 85:
            if z-coord of event-block is between 342 and 345:
                cancel event

on break:
    if x-coord of event-block is between 2882 and 2886:
        if y-coord of event-block is between 77 and 82:
            if z-coord of event-block is between 340 and 346:
                cancel event
                if event-block is reinforced deepslate:
                    if player's tool is air:
                        if {감옥수감유무::%uuid of player%} is true:
                            add 1 to {감옥수감카운트::%uuid of player%}
                            if {감옥수감카운트::%uuid of player%} >= 5:
                                send "%nl%&7&l<&e &l공지 &7&l> &r&e%player%번님이 석방 되셨습니다%nl%" to all players
                                delete {감옥수감유무::%uuid of player%}
                                delete {감옥수감카운트::%uuid of player%}
                                set {_randomtp} to random integer between 1 and 4
                                if {_randomtp} is 1:
                                    teleport player to location at 2885.5, 80, 373.5 in world "world"
                                if {_randomtp} is 2:
                                    teleport player to location at 2860.5, 80, 400.5 in world "world"
                                if {_randomtp} is 3:
                                    teleport player to location at 2835.5, 80, 373.5 in world "world"
                                if {_randomtp} is 4:
                                    teleport player to location at 2860.5, 80, 350.5 in world "world"
                                wait 3 tick
                                play sound "entity.player.levelup" to player
                            else if {감옥수감카운트::%uuid of player%} < 5:
                                play sound "entity.experience_orb.pickup" to player
                                send "&e석방까지 채굴 %5-{감옥수감카운트::%uuid of player%}%번 남으셨습니다" to player
                    else if player's tool is not air:
                        send "&e맨손으로 블럭을 캐지않아 카운트되지 않았습니다" to player
                        play sound "entity.enderman.teleport" to player


                    if loop-player is not player:
                        set {호감도타겟::%uuid of player%} to loop-player
                        open chest with 4 rows named "%{호감도타겟::%uuid of player%}%번 호감도 올리기/내리기" to player
                        set slot 13 of current inventory of player to itemsadder item "ab:up" named "&a호감도올리기"
                        set slot 22 of current inventory of player to itemsadder item "ab:down" named "&c호감도내리기"
                    else:
                        send "&c본인에게는 투표할 수 없습니다" to player
    if inventory name contain "번 호감도 올리기/내리기":
        cancel event
        if clicked slot is 13:
            send "&e%{호감도타겟::%uuid of player%}%번님의 호감도를 올렸습니다" to player
            send "&e%player%번님이 당신의 호감도를 올렸습니다" to {호감도타겟::%uuid of player%}
            play sound "entity.experience_orb.pickup" to player
            play sound "entity.experience_orb.pickup" to {호감도타겟::%uuid of player%}
            add 1 to {호감도::%uuid of {호감도타겟::%uuid of player%}%}
            remove itemsadder item "ab:hogam" from player's held item
            close player's inventory
        if clicked slot is 22:
            send "&e%{호감도타겟::%uuid of player%}%번님의 호감도를 내렸습니다" to player
            send "&e%player%번님이 당신의 호감도를 내렸습니다" to {호감도타겟::%uuid of player%}
            remove 1 from {호감도::%uuid of {호감도타겟::%uuid of player%}%}
            remove itemsadder item "ab:hogam" from player's held item
            play sound "entity.experience_orb.pickup" to player
            play sound "entity.experience_orb.pickup" to {호감도타겟::%uuid of player%}
            close player's inventory

on join:
    wait 20 tick
    if {출첵::%uuid of player%} is not true:
        add itemsadder item "ab:hogam" to {post.%uuid of player%::*}
        set {출첵::%uuid of player%} to true
        send "%nl%&e우편함에 &c'호감도' &e아이템이 지급되었습니다%nl%" to player

command z호감도확인 [<player>]:
    trigger:
        if player is op:
            send "%arg-player%님의 호감도 : %{호감도::%uuid of arg-player%}%" to player

command z호감도설정 [<player>] [<integer>]:
    trigger:
        if player is op:
            set {호감도::%uuid of arg-player%} to arg-integer
            send "%arg-player%님의 호감도를 %arg-integer%로 설정했습니다" to player
            send "%arg-player%님의 호감도 : %{호감도::%uuid of arg-player%}%" to player

every 19 tick:
    loop all players:
        if "%{호감도::%uuid of loop-player%}%" contain "-":
            apply potion of slowness of tier 2 without particles to loop-player for 1 second

command 벌금제출 [<integer>]:
    trigger:
        set {_ma} to arg-integer*7
        set {_da} to amount of diamond in inventory of player
        if "%{호감도::%uuid of player%}%" contain "-":
            if {호감도::%uuid of player%}+arg-integer <= 0:
                if {_ma} <= {_da}:
                    add arg-integer to {호감도::%uuid of player%}
                    remove {_ma} of diamond from player
                    send "&b다이아몬드 &e%{_ma}%개를 반납하여 호감도 %arg-integer%을(를) 올렸습니다" to player
                    play sound "entity.experience_orb.pickup" to player
                else:
                    send "&c호감도 %arg-integer%을(를) 올리기 위해서는 다이아몬드 %{_ma}%개 이상 필요합니다" to player
                    play sound "entity.enderman.teleport" to player
            else:
                send "&c호감도를 %arg-integer%만큼 올리면 당신의 호감도가 0이 넘어가기 때문에 사용할 수 없습니다" to player
        else:
            send "&c벌금을 제출하여 호감도를 올릴때는 당신의 호감도가 마이너스 여야합니다" to player

command z출첵초기화 [<player>]:
    trigger:
        if player is op:
            send "%arg-player%님의 출첵여부를 초기화하였습니다" to player
            delete {출첵::%uuid of arg-player%}

on rightclick:
    if name of player's held item is "&f강제결혼권":
        if {결혼사용쿨타임::%uuid of player%} is not true:
            set {결혼창염::%uuid of player%} to true
            open chest with 6 rows named "강제결혼 (강제결혼 시킬 대상을 선택해주세요)" to player
            play sound "minecraft:entity.experience_orb.pickup" with volume 1 to player
            set {_slot} to 0
            loop {관리자제외전체인원::*}:
                set {_head} to skull of loop-value
                set name of {_head} to "&f%loop-value%"
                set slot {_slot} of player's current inventory to {_head}
                add 1 to {_slot}
            set slot 49 of current inventory of player to itemsadder item "ab:hogam" named "&c결혼시키기"
        else:
            send "&c현재는 강제결혼권을 사용할 수 없습니다(15분쿨타임)" to player

on inventory close:
    if {결혼창염::%uuid of player%} is true:
        delete {결혼창염::%uuid of player%}
        delete {강제결혼권1%uuid of player%::*}

on inventory click:
    if inventory name is "강제결혼 (강제결혼 시킬 대상을 선택해주세요)":
        cancel event
        if event-item is not air:
            if clicked slot is not 49:
                loop all players:
                    if event-item's name is "&f%name of loop-player%":
                        play sound "entity.experience_orb.pickup" to player
                        if {강제결혼권1%uuid of player%::*} does not contain loop-player:
                            if size of {강제결혼권1%uuid of player%::*} < 2:
                                if {강제결혼권1%uuid of player%::1} is not set:
                                    set {강제결혼권1%uuid of player%::1} to loop-player
                                    send "&e신랑을 %loop-player%번님으로 설정하였습니다" to player
                                else:
                                    set {강제결혼권1%uuid of player%::2} to loop-player
                                    send "&e신부를 %loop-player%번님으로 설정하였습니다" to player
                            else:
                                send "&c결혼 대상은 최대 2명까지만 설정할 수 있습니다" to player
                        else:
                            send "&e%loop-player%번님을 결혼대상에서 제거했습니다" to player
                            remove loop-player from {강제결혼권1%uuid of player%::*}
            else if clicked slot is 49:
                if size of {강제결혼권1%uuid of player%::*} = 2:
                    send "%nl%&f[&a결혼&f] &e(%player%번이 결혼권 사용) 신랑 %{강제결혼권1%uuid of player%::1}%번과 신부 %{강제결혼권1%uuid of player%::2}%번이 결혼했습니다. 이 둘은 15분동안 멀어질 수 없습니다.%nl%" to all players
                    play sound "entity.player.levelup" to all players
                    add {강제결혼권1%uuid of player%::1} to {결혼시킴%uuid of player%::*}
                    add {강제결혼권1%uuid of player%::2} to {결혼시킴%uuid of player%::*}
                    remove itemsadder item "ab:gangjae" from player's held item
                    delete {결혼창염::%uuid of player%}
                    set {결혼사용쿨타임::%uuid of player%} to true
                    wait 1 tick
                    close player's inventory
                    wait 900 second
                    send "&e15분이 지나 %{결혼시킴%uuid of player%::1}%번님과 이혼하였습니다" to {결혼시킴%uuid of player%::2}
                    send "&e15분이 지나 %{결혼시킴%uuid of player%::2}%번님과 이혼하였습니다" to {결혼시킴%uuid of player%::1}
                    play sound "entity.experience_orb.pickup" to {결혼시킴%uuid of player%::*}
                    delete {결혼시킴%uuid of player%::*}
                    delete {강제결혼권1%uuid of player%::*}
                    delete {결혼사용쿨타임::%uuid of player%}
                else:
                    send "&c결혼 대상은 2명 이여야 합니다" to player
                    play sound "entity.enderman.teleport" to player

command z결혼쿨타임초기화 [<player>]:
    trigger:
        if player is op:
            delete {결혼사용쿨타임::%uuid of arg-player%}
            send "%arg-player%님의 결혼 쿨타임을 초기화했습니다" to player

every 1 second:
    loop all players:
        if {결혼시킴%uuid of loop-player%::*} is set:
            set {_g1%uuid of loop-player%} to {결혼시킴%uuid of loop-player%::1}
            set {_g2%uuid of loop-player%} to {결혼시킴%uuid of loop-player%::2}
            set {_distance} to distance between location of {_g1%uuid of loop-player%} and location of {_g2%uuid of loop-player%}
            if {_distance} > 10:
                teleport {_g2%uuid of loop-player%} to {_g1%uuid of loop-player%}

command z강제결혼초기화:
    trigger:
        if player is op:
            loop all players:
                delete {결혼시킴%uuid of loop-player%::*}
                delete {강제결혼권1%uuid of loop-player%::*}

command z죽인횟수확인:
    trigger:
        if player is op:
            send "" to player
            loop {관리자제외전체인원::*}:
                send "%loop-value%님의 죽인횟수 : %{죽인횟수::%uuid of loop-value%}%" to player
            send "" to player

command z죽은횟수확인:
    trigger:
        if player is op:
            send "" to player
            loop {관리자제외전체인원::*}:
                send "%loop-value%님의 죽은횟수 : %{죽은횟수::%uuid of loop-value%}%" to player
            send "" to player

command z관리자채팅 [<text>]:
    trigger:
        if player is op:
            if arg-text is set:
                send "&f[관리자채팅] <%player%> &7: &f%arg-text%" to {관리자::*}

command z번호확인:
    trigger:
        if player is op:
            send "%player's target%님의 번호 : %{번호::%uuid of player's target%}%" to player

command z아이템이름 [<text>]:
    trigger:
        if player is op:
            set name of player's tool to "&f%arg-text%"

command zbgm:
    trigger:
        if player is op:
            play sound "music_disc.otherside" to all players

on player's held item change:
    if {카드타이틀로확인::%player%} is true:
        delete {카드타이틀로확인::%player%}
        set slot 36 of player's inventory to air

on rightclick with iron ingot:
    if name of player's held item contain "색 쪽지":
        if {카드타이틀로확인::%uuid of player%} is not true:
            set {카드타이틀로확인::%uuid of player%} to true
            console command "item replace entity %uuid of player% armor.feet with light_gray_stained_glass_pane[equippable={slot:""feet"",camera_overlay:""misc/il""}]"
            wait 1 tick
            set name of slot 36 of player's inventory to " "
        else if {카드타이틀로확인::%uuid of player%} is true:
            delete {카드타이틀로확인::%uuid of player%}
            set slot 36 of player's inventory to air

on inventory click:
    if clicked inventory is player's inventory:
        if clicked slot is 36:
            if event-item is light gray stained glass pane:
                cancel event

on rightclick on entity:
    if name of event-entity is "&fasdf1234567":
        cancel event
        if {상자염} is not true:
            set {상자염} to true
            wait 1 tick
            drop paper named "&6100만원" at event-location

command z상자연사람초기화:
    trigger:
        if player is op:
            delete {상자염}

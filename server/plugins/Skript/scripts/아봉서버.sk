                            give event-item with lore "" to player
                        else:
                            send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                            play sound "entity.enderman.teleport" to player
                    if "%event-clicktype%" is "left mouse button with shift":
                        if {_sa} >= 40:
                            play sound "minecraft:entity.experience_orb.pickup" to player
                            remove 40 stone block from player
                            loop 10 times:
                                give event-item with lore "" to player
                        else:
                            send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                            play sound "entity.enderman.teleport" to player
                    if "%event-clicktype%" is "right mouse button with shift":
                        if {_sa} >= 256:
                            play sound "minecraft:entity.experience_orb.pickup" to player
                            remove 256 stone block from player
                            loop 64 times:
                                give event-item with lore "" to player
                        else:
                            send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                            play sound "entity.enderman.teleport" to player
    if inventory name is "&f콘크리트 상점":
        cancel event
        if event-item is not air:
            if clicked slot is not 18:
                if clicked inventory is not player's inventory:
                    wait 1 tick
                    set {_ca} to amount of cobblestone block in inventory of player
                    if "%event-clicktype%" is "left mouse button":
                        if {_ca} >= 2:
                            play sound "minecraft:entity.experience_orb.pickup" to player
                            remove 2 cobblestone block from player
                            give event-item with lore "" to player
                        else:
                            send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                            play sound "entity.enderman.teleport" to player
                    if "%event-clicktype%" is "left mouse button with shift":
                        if {_ca} >= 20:
                            play sound "minecraft:entity.experience_orb.pickup" to player
                            remove 20 cobblestone block from player
                            loop 10 times:
                                give event-item with lore "" to player
                        else:
                            send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                            play sound "entity.enderman.teleport" to player
                    if "%event-clicktype%" is "right mouse button with shift":
                        if {_ca} >= 128:
                            play sound "minecraft:entity.experience_orb.pickup" to player
                            remove 128 cobblestone block from player
                            loop 64 times:
                                give event-item with lore "" to player
                        else:
                            send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                            play sound "entity.enderman.teleport" to player

on inventory click:
    if inventory name is "강제결혼권 상점":
        cancel event
        if clicked slot is 13:
            set {_da} to amount of diamond in inventory of player
            if {_da} >= 64:
                send "%nl%&c강제결혼권&e을 성공적으로 구매하였습니다.%nl%" to player
                play sound "minecraft:entity.experience_orb.pickup" to player
                remove 64 diamond from player
                give itemsadder item "ab:gangjae" to player
            else:
                send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                play sound "entity.enderman.teleport" to player
    if inventory name is "&9초대권 상점":
        cancel event
        if clicked slot is 13:
            set {_da} to amount of diamond in inventory of player
            if {_da} >= {초대권구매비용}:
                send "%nl%&e초대권을 성공적으로 구매하였습니다.%nl%" to player
                play sound "minecraft:entity.experience_orb.pickup" to player
                loop {초대권구매비용} times:
                    remove 1 diamond from player
                set {초대권구매비용} to {초대권구매비용}+5
                set slot 13 of current inventory of player to itemsadder item "ab:invite" named "&e초대권" with lore "&e구매비용 : &b다이아몬드 &e%{초대권구매비용}%개"
                give itemsadder item "ab:invite" named "&e초대권" to player
            else:
                send "%nl%&c아이템을 구매하기 위한 비용이 부족합니다.%nl%" to player
                play sound "entity.enderman.teleport" to player
    if inventory name is "&f편지 상점":
        cancel event
        if clicked slot is 13:
            send "%nl%&e편지를 성공적으로 획득하였습니다.%nl%" to player
            play sound "minecraft:entity.experience_orb.pickup" to player
            give 1 writable book named "&f편지" to player

every 20 tick:
    loop all players:
        add 0 to {죽은횟수::%uuid of loop-player%}
        add 0 to {죽인횟수::%uuid of loop-player%}
        add 0 to {호감도::%uuid of loop-player%}
        wipe loop-player's sidebar
        set name of sidebar of loop-player to "&e정보"
        set {_realtime2} to now formatted human-readable as "hh:mm"
        set score "&e당신의 표지판 제한 횟수 : %{s.l::%uuid of loop-player%}%회" in sidebar of loop-player to 4
        set score "&e당신의 호감도 : %{호감도::%uuid of loop-player%}%" in sidebar of loop-player to 3
        set score "&e현재시각 : %{_realtime2}%" in sidebar of loop-player to 2
        set score "&c죽인횟수 : %{죽인횟수::%uuid of loop-player%}%" in sidebar of loop-player to 1
        set score "&c죽은횟수 : %{죽은횟수::%uuid of loop-player%}%" in sidebar of loop-player to 0

command z죽은횟수초기화 [<player>]:
    trigger:
        if player is op:
            delete {죽은횟수::%uuid of arg-player%}
            send "%arg-player%님의 죽은횟수를 초기화했습니다(0)" to player

command z죽인횟수초기화 [<player>]:
    trigger:
        if player is op:
            delete {죽인횟수::%uuid of arg-player%}
            send "%arg-player%님의 죽인횟수를 초기화했습니다(0)" to player

on death of player:
    if attacker is player:
        add 1 to {죽은횟수::%uuid of victim%}
        add 1 to {죽인횟수::%uuid of attacker%}
        set death message to ""

command 공지 [<text>]:
    trigger:
        if player is op:
            send "%nl%&7&l<&e &l공지 &7&l> &r&e%arg-text%%nl%" to all players

on rightclick on entity:
    if name of entity contain "우체부":
        open chest with 4 rows named "&e우편 보내기" to player
        play sound "minecraft:entity.experience_orb.pickup" with volume 1 to player
        set {_SLOT} to 0
        loop 45 times:
            set slot {_SLOT} of current inventory of player to light blue stained glass pane named ""
            add 1 to {_SLOT}
        set slot 13 of current inventory of player to {우편아이템::%uuid of player%}
        set slot 31 of current inventory of player to itemsadder item "_iainternal:icon_next_orange" named "&e다음" with lore "&7빈칸에 편지를 넣고 버튼을 눌러주세요"
        set {우편1::%uuid of player%} to true

on inventory click:
    if inventory name is "&e우편 보내기":
        if event-item is not writable book:
            if clicked slot is not air:
                cancel event
                if clicked slot is 31:
                    if slot 13 of current inventory of player is writable book:
                        delete {우편1::%uuid of player%}
                        set {우편아이템::%uuid of player%} to slot 13 of current inventory of player
                        open chest with 6 rows named "&e우편 보내기 (보낼 사람을 선택해주세요)" to player
                        play sound "minecraft:entity.experience_orb.pickup" with volume 1 to player
                        set {_slot} to 0
                        loop {관리자제외전체인원::*}:
                            set {_head} to skull of loop-value
                            set name of {_head} to "&f%loop-value%"
                            set slot {_slot} of player's current inventory to {_head}
                            add 1 to {_slot}
                    else:
                        send "&c편지를 넣어주세요" to player
        if event-item is writable book:
            if clicked slot is 13:
                delete {우편아이템::%uuid of player%}
            else:
                set {우편아이템::%uuid of player%} to slot 13 of current inventory of player

on inventory click:
    if inventory name is "&e우편 보내기 (보낼 사람을 선택해주세요)":
        cancel event
        if event-item is not air:
            loop all players:
                if event-item's name is "&f%name of loop-player%":
                    if {우편보낸사람.%uuid of player%::%uuid of loop-player%} is not true:
                        set {우편보낸사람.%uuid of player%::%uuid of loop-player%} to true
                        add 1 to {우편보낸횟수::%uuid of player%}
                        set {우편보낼아이템%{우편보낸횟수::%uuid of player%}%::%uuid of player%} to {우편아이템::%uuid of player%}
                        set {우편받을사람%{우편보낸횟수::%uuid of player%}%::%uuid of player%} to uuid of loop-player
                        add player to {우편발송대기::*}
                        if {우편받는사람목록::*} does not contain loop-player:
                            add loop-player to {우편받는사람목록::*}
                        #add {우편아이템::%uuid of player%} to {post.%uuid of loop-player%::*}
                        send "%nl%&e편지를 발송하였습니다%nl%" to player
                        play sound "minecraft:entity.experience_orb.pickup" with volume 1 to player
                        #send "%nl%&e우편이 도착하였습니다%nl%" to loop-player
                        #play sound "minecraft:entity.experience_orb.pickup" with volume 1 to loop-player
                        delete {우편아이템::%uuid of player%}
                        close player's inventory
                    else:
                        send "&c같은 사람에게 편지는 하루에 최대 1번만 보낼 수 있습니다" to player

on inventory close:
    if {우편1::%uuid of player%} is true:
        delete {우편1::%uuid of player%}
        if {우편아이템::%uuid of player%} is not writable book:
            if slot 13 of current inventory of player is not air:
                set {_i} to slot 13 of current inventory of player
                give {_i} to player

on inventory click:
    if inventory name is "&e우편함":
        cancel event
        if clicked inventory is not player's inventory:
            if event-item is not air:
                set {_i2} to event-item
                set {_s2} to index of clicked slot
                set slot {_s2} of current inventory of player to air
                give {_i2} to player
                play sound "minecraft:entity.experience_orb.pickup" with volume 1 to player
                remove {_i2} from {post.%uuid of player%::*}
                open chest with 6 rows named "&e우편함" to player
                wait 1 tick
                set {_postinv} to 0
                loop {post.%uuid of player%::*}:
                    set slot {_postinv} of current inventory of player to loop-value
                    add 1 to {_postinv}

command ztp [<text>]:
    trigger:
        if player is op:
            loop all players:
                if name of loop-player is arg-text:
                    teleport player to loop-player

every 5 tick:
    loop all players:
        add amount of itemsadder item "ab:bag" in inventory of loop-player to {_mga.%uuid of loop-player%}
        add amount of itemsadder item "ab:bagblue" in inventory of loop-player to {_mga.%uuid of loop-player%}
        add amount of itemsadder item "ab:greenbag" in inventory of loop-player to {_mga.%uuid of loop-player%}
        add amount of itemsadder item "ab:orangebag" in inventory of loop-player to {_mga.%uuid of loop-player%}
        add amount of itemsadder item "ab:purplebag" in inventory of loop-player to {_mga.%uuid of loop-player%}
        add amount of itemsadder item "ab:redbag" in inventory of loop-player to {_mga.%uuid of loop-player%}
        add amount of itemsadder item "ab:skybluebag" in inventory of loop-player to {_mga.%uuid of loop-player%}
        add amount of itemsadder item "ab:yellowbag" in inventory of loop-player to {_mga.%uuid of loop-player%}
        if {_mga.%uuid of loop-player%} >= 1:
            apply potion of glowing of tier 1 without particles to loop-player for 6 tick

command /타이머 [<number>]:
	trigger:
		if arg-1 is set:
			set {Timer} to arg-1
			set {MaxTimer} to arg-1
			create bossbar titled "&f[&9남은 시간: &b%{Timer::%uuid of player%}%&9초&f]" and id "타이머" for player with progress 100 with colors blue with style segmented 10
		else:
			send "&c시간을 설정해주세요" to player

command /타이머제거:
	trigger:
		remove bossbar "타이머"
		delete {Timer}
		delete {MaxTimer}

every 2 tick:
	loop all players:
		if {Timer} is set:
			if {Timer} is 0:
				delete {Timer}
				delete {MaxTimer}
				remove bossbar "타이머"
				send "&4-----------------------" to loop-player
				send "&c&l시간 종료!!" to loop-player
				send "&4-----------------------" to loop-player
				stop
			subtract 0.1 from {Timer}
			set {_per} to {Timer}/{MaxTimer}*100
			if {_per} is between 80 and 100:
				set bossbar "타이머" color to blue
			else if {_per} is between 50 and 79.99:
				set bossbar "타이머" color to green
			else if {_per} is between 20 and 49.99:
				set bossbar "타이머" color to yellow
			else if {_per} is between 0 and 19.99:
				set bossbar "타이머" color to red
			set bossbar "타이머" progress to {_per}
			set bossbar "타이머" title to "&f[&9남은 시간: &f[&b%{Timer}%&9초&f]"

